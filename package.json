{
  "name": "zenith",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zenith - Görev, Alışkanlık, Odaklanma ve Yaşam Yönetim Sistemi",
  "scripts": {
    "build": "tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tailwind.src.css -o ./assets/css/tailwind.css --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test e2e/visual.spec.js --update-snapshots",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "serve": "node scripts/static-server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^13.4.1",
    "playwright-lighthouse": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "vitest": "^5.0.0"
  }
}
